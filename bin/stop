#!/usr/bin/env python3
"""bin/stop <run_id>: stop a live RepoMind run.

Writes the `requested` line to logs/stops.jsonl. From then on the hook (policy/hook.py)
refuses every call of that run, the first refusal writes `effective`, and the run saves
a checkpoint and ends `stopped`. A stop that arrives while the run waits for a person
withdraws the request. The run_id is in the run's live notification
(logs/notifications.jsonl). Resume it with: python run.py --resume <run_id>
"""

from __future__ import annotations

import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
sys.path.insert(0, str(ROOT))

from policy import stop  # noqa: E402


def latest_live() -> str | None:
    """The newest run whose live notification went out and whose trace has not ended."""
    from harness.notify import read
    for line in reversed(read()):
        if line.get("kind") != "live":
            continue
        trace = ROOT / "runs" / f"{line['run_id']}.jsonl"
        rows = trace.read_text().splitlines() if trace.exists() else []
        last_start = max((i for i, r in enumerate(rows) if '"type": "run_start"' in r or '"type": "resume"' in r),
                         default=-1)
        if not any('"type": "end"' in r for r in rows[last_start + 1:]):
            return line["run_id"]
    return None


def main(argv: list[str]) -> int:
    if len(argv) != 1 or (argv[0].startswith("-") and argv[0] != "--latest"):
        print(__doc__.strip() + "\n\nbin/stop --latest stops the newest live run named by a live notification.",
              file=sys.stderr)
        return 2
    run_id = latest_live() if argv[0] == "--latest" else argv[0].strip()
    if run_id is None:
        print("no live run: no live notification without an ended trace", file=sys.stderr)
        return 1
    if not (ROOT / "runs" / f"{run_id}.jsonl").exists():
        print(f"note: runs/{run_id}.jsonl does not exist (yet); the stop is recorded anyway", file=sys.stderr)
    if stop.is_stopped(run_id):
        print(f"{run_id} is already stopped")
        return 0
    line = stop.request(run_id)
    print(f"stop requested for {run_id} at {line['at']}; its next call is refused. "
          f"Resume with: python run.py --resume {run_id}")
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
